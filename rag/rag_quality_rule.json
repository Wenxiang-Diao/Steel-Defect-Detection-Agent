{
  "version": "coverage-003",
  "scope": "表面图像覆盖程度评价；阈值为系统配置，不是国家标准限值或产品合格认证。",
  "metric": "同类预测像素占整张图片的比例；不同类别不相加。",
  "bands": [
    {
      "id": "low",
      "min": 0,
      "max": 0.01,
      "include_min": false,
      "include_max": false,
      "recommendation": "PASS",
      "review_reason": "",
      "action": "记录类别、位置和面积比例。"
    },
    {
      "id": "medium",
      "min": 0.01,
      "max": 0.05,
      "include_min": true,
      "include_max": true,
      "recommendation": "REVIEW",
      "review_reason": "面积处于1%至5%（含边界），需对照原图核对类别及标记范围。",
      "action": "人工核对类别及标记范围，必要时更正或重新检测。"
    },
    {
      "id": "high",
      "min": 0.05,
      "max": 1,
      "include_min": false,
      "include_max": true,
      "recommendation": "FAIL",
      "review_reason": "",
      "action": "标记覆盖比例超限，列入待处理清单。"
    }
  ],
  "classes": {
    "inclusion": {
      "rule_id": "quality-inclusion-003"
    },
    "patch": {
      "rule_id": "quality-patch-003"
    },
    "scratch": {
      "rule_id": "quality-scratch-003"
    }
  }
}
